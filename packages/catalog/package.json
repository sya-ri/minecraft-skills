{
  "name": "@minecraft-skills/catalog",
  "version": "0.0.0",
  "type": "module",
  "description": "Validated catalog APIs for Minecraft Skills data consumers.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@minecraft-skills/data": "workspace:0.0.0",
    "arktype": "2.2.1"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260621.1",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}

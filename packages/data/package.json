{
  "name": "@minecraft-skills/data",
  "version": "0.1.5",
  "type": "module",
  "description": "Canonical versioned Minecraft data for AI skills, CLI, and MCP tools.",
  "license": "MIT",
  "keywords": [
    "minecraft",
    "datapack",
    "resourcepack",
    "paper",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sya-ri/minecraft-skills.git",
    "directory": "packages/data"
  },
  "bugs": {
    "url": "https://github.com/sya-ri/minecraft-skills/issues"
  },
  "homepage": "https://github.com/sya-ri/minecraft-skills#readme",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "data",
    "!data/java/datapack-schema-surfaces",
    "!data/java/paper-api-surfaces",
    "!data/java/resourcepack-models",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260621.1",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
